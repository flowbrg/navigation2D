        <mxCell id="VDm2wrdBnlTMptT0TTgu-2" parent="WUU0yxVFWuJvOViH3bZZ-1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="\( S \)" vertex="1">
          <mxGeometry height="30" width="50" x="110" y="180" as="geometry" />
        </mxCell>
        <mxCell id="VDm2wrdBnlTMptT0TTgu-3" edge="1" parent="WUU0yxVFWuJvOViH3bZZ-1" style="endArrow=none;dashed=1;html=1;rounded=0;fillColor=#f5f5f5;strokeColor=#666666;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
